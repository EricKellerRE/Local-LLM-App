# Hugging Face repository ID or a local directory containing a causal language model.
LOCAL_MODEL_ID=
# Most text-only models use the causal loader automatically. Gemma 4 uses the
# multimodal loader even for text chats; `auto` detects it from config.json.
LOCAL_MODEL_KIND=auto
# Optional CPU memory limit. When set, Accelerate can place the remaining
# layers in LOCAL_MODEL_OFFLOAD_DIR instead of exhausting system RAM.
LOCAL_MODEL_CPU_MEMORY_GB=
LOCAL_MODEL_OFFLOAD_DIR=

# auto lets Accelerate place the model when available. Use cpu or cuda to force a device.
LOCAL_MODEL_DEVICE=auto
LOCAL_MODEL_DTYPE=auto
LOCAL_MODEL_MAX_NEW_TOKENS=512
LOCAL_MODEL_TEMPERATURE=0.7
LOCAL_MODEL_TOP_P=0.9
# Bounded coordinator phases. Tool decisions default to greedy decoding for
# reproducibility; ordinary chat keeps the sampling settings above.
LOCAL_PLANNER_MAX_NEW_TOKENS=192
LOCAL_TOOL_ACTION_MAX_NEW_TOKENS=192
LOCAL_TOOL_FINAL_MAX_NEW_TOKENS=256
LOCAL_TOOL_TEMPERATURE=0
LOCAL_MODEL_TRUST_REMOTE_CODE=false

# Root of the separate repository that owns power-domain MCP servers and playbooks.
GRID_WORKSHOP_ROOT=C:/Users/your-name/Documents/Grid-Workshop

# Optional: set to 1 after model weights have been cached to prevent network access.
# HF_HUB_OFFLINE=1

# Persistent local server. Keep the host on loopback unless you intentionally
# want to expose the model to other devices on your network.
LOCAL_MODEL_SERVER_URL=http://127.0.0.1:8765
LOCAL_MODEL_SERVER_HOST=127.0.0.1
LOCAL_MODEL_SERVER_PORT=8765
LOCAL_MODEL_EAGER_LOAD=true

# Durable task worker. Each running episode owns a renewable database lease;
# an expired lease is recovered automatically after a restart.
LOCAL_TASK_POLL_SECONDS=5
LOCAL_TASK_LEASE_SECONDS=1800
